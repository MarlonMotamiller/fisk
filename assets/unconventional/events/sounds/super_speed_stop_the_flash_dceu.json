{
  "parent": "fiskheroes:sound_base",
  "sound": "unconventional:flash.dceu.stop",
  "condition": {
    "start": "!entity.isInWater() && !entity.getData('fiskheroes:speeding')"
  },
  "volume": "Math.min(0.0 + (entity.getData('fiskheroes:speed') - 1) * 0.5, 1)",
  "pitch": "1.0 + Math.random() * 0.3",
  "fadeOut": 5
}
