{
  "sound": "fiskheroes:suit.manta.beam.loop",
  "condition": "entity.getData('fiskheroes:beam_shooting') > 0",
  "volume": "0.65*entity.getInterpolatedData('fiskheroes:beam_shooting_timer')",
  "pitch": "2.0  - 0.1 * Math.min(entity.getInterpolatedData('fiskheroes:heat_vision_length'), 2)",
  "loop": true
}
