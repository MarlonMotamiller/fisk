{
  "name": "Robin Armor (Rocksteady)",
  "modifiers": {
    "fiskheroes:controlled_flight": {
      "speed": 0.2,
      "boostSpeed": 0.2,
      "canBoost": true,
      "canRoll": true,
      "barrelRoll": {
        "duration": 21,
        "speed": 0.1,
        "drag": 0.0
      },
      "diveSpeedRetention": 0.5,
      "collision": {
        "blocks": {
          "stopFlying": true,
          "takeDamage": true
        },
        "entities": {
          "stopFlying": true,
          "dealDamage": true
        }
      },
      "knockback": 0.0
    },
    "fiskheroes:shadowdome|enable": {
      "chargeTime": 0,
      "duration": 1,
      "radius": 26.0,
      "soundEvents": {
        "CAST": "unconventional:scan_zone_swipe"
      }
    },
	"fiskheroes:cooldown|shadow_dome": {
      "cooldown": {
        "toggleData": "entity.getData('fiskheroes:lightsout')",
        "cooldownData": "unconventional:dyn/cooldown_1",
        "duration": 2,
        "recovery": 0.08
      }
    },
    "fiskheroes:equipment": {
      "equipment": {
        "fiskheroes:batarang": {
          "cooldown": 10,
          "uses": 2,
          "damageProfile": {
            "damage": 8.0,
            "types": {
              "SHURIKEN": 1.0
            },
            "properties": {
              "DAMAGE_DROPOFF": 0.6,
              "HIT_COOLDOWN": 0
            }
          }
        },
        "fiskheroes:grenade": {
          "cooldown": 80,
          "uses": 3,
          "damageProfile": {
            "properties": {
              "REDUCE_KNOCKBACK": 1.25,
              "EFFECTS": [
                {
                  "id": "fiskheroes:flashbang",
                  "duration": 50,
                  "amplifier": 0,
                  "chance": 1
                },
                {
                  "id": "minecraft:blindness",
                  "duration": 30,
                  "amplifier": 0,
                  "chance": 1
                },
                {
                  "id": "minecraft:nausea",
                  "duration": 20,
                  "amplifier": 0,
                  "chance": 1.0
                }
              ]
            }
          },
          "isInstant": true,
          "affectsUser": true,
          "fuseTime": 30,
          "radius": 5.0
        }
      },
      "soundEvents": {
        "SWITCH": "fiskheroes:utility_belt_switch"
      }
    },
    "fiskheroes:damage_resistance|bullet": {
      "damageType": "BULLET",
      "factor": 0.35
    },
    "fiskheroes:shield": {
      "isToggle": false,
        "shield": {
          "health": 80.0,
          "regeneration": 8.0,
          "recoveryDelay": 40,
          "cooldown": 80
        },
        "coverage": {
          "yawRadius": 45.0,
          "pitchRadius": 45.0,
          "yawOffset": 0.0,
          "pitchOffset": 0.0
        },
        "knockback": 0.1,
        "soundEvents": {
          "ENABLE": "fiskheroes:utility_belt_switch",
          "DISABLE": "fiskheroes:utility_belt_switch",
          "DEFLECT": "fiskheroes:shield_deflect"
        }
    },
    "fiskheroes:gliding": {
      "gliding": {
        "speed": 1.0,
        "lift": 1.0,
        "gravity": 1.0,
        "stall": 0.0
      },
      "isPowered": false,
      "isControlled": false,
      "canJumpActivate": true,
      "collision": {
        "blocks": {
          "stopFlying": true,
          "takeDamage": true
        },
        "entities": {
          "stopFlying": true,
          "dealDamage": true
        }
      },
      "knockback": 1.2,
      "soundEvents": {
        "ENABLE": ["fiskheroes:cape_open", "fiskheroes:gliding"],
        "DISABLE": "fiskheroes:cape_close"
      }
    }
  },
  "hud": [
    {
      "type": "CHARGE",
      "texture": "unconventional:textures/gui/bars/sliding_timer.png",
      "data": "var x = entity.getData('unconventional:dyn/sliding_cooldown'); x == 0 ? 0 : 1 - x"
    }
  ]
}
