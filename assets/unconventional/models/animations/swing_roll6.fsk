{x} = curve {data}
{data} = sin(pi(1 - {data}))^2

{head_rotX} @ {data} -> 0.6
{rightArm_rotX} @ {data} -> -1.8
{rightArm_rotY} @ {data} -> -0.7
{rightArm_rotZ} @ {data} -> -0.1
{leftArm_rotX} @ {data} -> -1.7
{leftArm_rotY} @ {data} -> 0.8
{leftArm_rotZ} @ {data} -> 0.1

{rightLeg_posY} @ {data} -> 5.5
{rightLeg_posZ} @ {data} -> -7.45
{rightLeg_rotX} @ {data} -> 0.8
{rightLeg_rotY} @ {data} -> -0.5

{leftLeg_posY} @ {data} -> 5.35
{leftLeg_posZ} @ {data} -> -3.45
{leftLeg_rotX} @ {data} -> 0.4
{leftLeg_rotY} @ {data} -> -0.5

out "pivot" (0, 0.6, 0)
out "rotate" (-360{x}, 1, 0, -0.6)
