{x} = min({vel}, 1){data_1}{d1}{d} / 2.5
{vertLook} = clamp(-{lookY},-30', 10')
{head_rotX} -= 15'{data_1}
{rightArm_rotX} -= 160'{data_1} + abs(0.5{x}) - 0.5{vertLook}
{rightArm_rotY} += 8'{data_1}
{rightArm_rotZ} -= 4'{data_1} + abs(0.5{x}) + 0.3{head_rotY}


{leftArm_rotX} += 8'{data_1} + 0.5abs({x})
{leftArm_rotY} -= 18'{data_1}
{leftArm_rotZ} -= 12'{data_1}

{rightLeg_rotX} += 20'{data_1} + 0.3{x}
{rightLeg_rotY} += 3'{data_1}
{rightLeg_rotZ} += 5'{data_1}
{leftLeg_rotX} += 20'{data_1} - 0.3{x}
{leftLeg_rotY} -= 3'{data_1}
{leftLeg_rotZ} -= 5'{data_1}

{d} *= {data_1} / 1'
{x} = min({vel} / 2, 1) / 2
out "rotate" (-{data_1}({pitch} + 75), 1, 0, 0)
out "rotate" ({d1}{d}, 0, 1, 0)
out "rotate" (-{d1}{d}{x}, 0, 0, 1)
out "rotate" ({d}{x}, 1, 0, 0)
out "translate" (0, -0.8{data_1}, 0)
