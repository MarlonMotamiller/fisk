{x} = curve {data}
{data} = sin(pi(1 - {data}))^3

{head_rotX} @ {data} -> max({head_rotX} - 0.4, -90')
{rightArm_rotX} @ {data} -> -0.5
{rightArm_rotY} @ {data} -> 0
{rightArm_rotZ} @ {data} -> -0.1
{leftArm_rotX} @ {data} -> -0.5
{leftArm_rotY} @ {data} -> 0
{leftArm_rotZ} @ {data} -> 0.1

{rightLeg_posY} @ {data} -> -2.5
{leftLeg_posY} @ {data} -> -2.5

out "pivot" (0, 0.5, 0)
out "rotate" (-180{x}, 0, 1, 0)
