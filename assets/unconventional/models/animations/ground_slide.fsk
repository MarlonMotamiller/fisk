{x} = curve {data}
{data} = sin(pi(1 - {data}))^2

{head_posX} @ {data} -> -1.5
{head_posY} @ {data} -> 0
{head_posZ} @ {data} -> -1.25

{head_rotX} @ {data} -> 0.175
{head_rotY} @ {data} -'> 0.10
{head_rotZ} @ {data} -> -0.25


{body_posX} @ {data} -> 0
{body_posY} @ {data} -> 0
{body_posZ} @ {data} -> 0

{body_rotX} @ {data} -> -0.875
{body_rotY} @ {data} -'> 0.5
{body_rotZ} @ {data} -> -1.05


{rightArm_posX} @ {data} -> -2.25
{rightArm_posY} @ {data} -> 3.5
{rightArm_posZ} @ {data} -> 2

{rightArm_rotX} @ {data} -> 0.7
{rightArm_rotY} @ {data} -'> 0.3
{rightArm_rotZ} @ {data} -> 0.2


{leftArm_posX} @ {data} -> 4.0
{leftArm_posY} @ {data} -> -2.5
{leftArm_posZ} @ {data} -> -3.25

{leftArm_rotX} @ {data} -> -0.75
{leftArm_rotY} @ {data} -'> 0.65
{leftArm_rotZ} @ {data} -> -1.6


{rightLeg_posX} @ {data} -> -1.75
{rightLeg_posY} @ {data} -> 9
{rightLeg_posZ} @ {data} -> -9.5

{rightLeg_rotX} @ {data} -> -0.1
{rightLeg_rotY} @ {data} -'> 0.15
{rightLeg_rotZ} @ {data} -> -1.45


{leftLeg_posX} @ {data} -> 5
{leftLeg_posY} @ {data} -> 6.5
{leftLeg_posZ} @ {data} -> -9

{leftLeg_rotX} @ {data} -> -1.25
{leftLeg_rotY} @ {data} -'> 0.0
{leftLeg_rotZ} @ {data} -> -0.45

out "pivot" (0, 0.5, 0)
out "translate" (0.2{data}, -0.775{data}, 0)
