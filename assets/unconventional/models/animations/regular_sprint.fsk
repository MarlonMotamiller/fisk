{data} = curve {data}
{limbSwingAmount} *= {data}
{rightArm_rotZ} -= 0.2{limbSwingAmount}cos(0.6662{limbSwing} - 0.4)
{leftArm_rotZ} -= 0.2{limbSwingAmount}cos(0.6662{limbSwing} - 0.4)
{rightArm_rotX} += 0.2{limbSwingAmount}cos(0.6662{limbSwing} + pi)
{leftArm_rotX} += 0.2{limbSwingAmount}cos(0.6662{limbSwing})

{f} = {limbSwingAmount}cos(0.6662{limbSwing} - 0.3)
{body_rotY} -= 0.2{f}
{rightArm_posZ} -= 1.25{f}
{leftArm_posZ} += 1.25{f}

{head_rotX} -= 5'{data}
{rightLeg_rotX} -= 2'{data}
{leftLeg_rotX} -= 2'{data}

out "translate" (0, 0, 0.1{data})
out "rotate" (-5{data}, 1, 0, 0)
