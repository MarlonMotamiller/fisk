{cosa} = cos({bodyYaw}')
{sina} = sin({bodyYaw}')
{strafe} = {motX}{cosa} + {motZ}{sina}
{forward} = {motZ}{cosa} - {motX}{sina}

{vel} = sqrt({motX}^2 + {motZ}^2)
{dir} = sqrt({lookX}^2 + {lookZ}^2)

{x} = min(2{vel}, 1)
{strafe} *= {x}
{forward} *= {x}

{adz} = abs {forward}

{cloth_L_rotZ} += 15'{strafe}
{cloth_L_rotX} -= 15'min({adz}*2, 1) +  25' *( -cos(pi({limbSwingAmount}cos(0.6662{limbSwing} - 0.4))) + 1) 


{cloth_R_rotZ} += 15'{strafe}
{cloth_R_rotX} -= 15'min({adz}*2, 1) +  25' *( -cos(pi({limbSwingAmount}cos(0.6662{limbSwing} - 0.4))) + 1) 