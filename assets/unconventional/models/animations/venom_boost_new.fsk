; data_0 = flight_timer
; data_1 = flight_boost_timer

{data_0} = curve {data_0}
{data_1} = curve {data_1}
{x} = 1 - {data_0}

; Boosted/stationary "base" positioning
{rightArm_rotX} @ {data_0} -> 15'{data_1}
{rightArm_rotY} *= {x}
{rightArm_rotZ} @ {data_0} -> 12' + 10'{data_1}
{leftArm_rotX} @ {data_0} -> 15'{data_1}
{leftArm_rotY} *= {x}
{leftArm_rotZ} @ {data_0} -> -12' - 10'{data_1}
{rightLeg_rotX} @ {data_0} -> 15'{data_1}
{rightLeg_rotY} *= {x}
{rightLeg_rotZ} *= {x}
{leftLeg_rotX} @ {data_0} -> 15'{data_1}
{leftLeg_rotY} *= {x}
{leftLeg_rotZ} *= {x}
{head_rotX} @ {data_1} -> -40'

; ==============================================
{vel} = sqrt({motX}^2 + {motZ}^2)
{dir} = sqrt({lookX}^2 + {lookZ}^2)

{d} = acos clamp(if({dir} > 0 && {vel} > 0, ({motX}{lookX} + {motZ}{lookZ}) / {vel} / {dir}, 1), -1, 1)
{d1} = signum({motX}{lookZ} - {motZ}{lookX})

{cosa} = cos({bodyYaw}')
{sina} = sin({bodyYaw}')
{strafe} = {motX}{cosa} + {motZ}{sina}
{forward} = {motZ}{cosa} - {motX}{sina}

; Moving animation
{forward} *= {data_0}min(2{vel}, 1)
{adz} = abs {forward}

{x} = min({vel}, 1){data_0}{d1}{d} / 2.5

{head_rotX} -= 40'{data_0}
{rightArm_rotX} += 20'{data_0} + {x} + 0.15{forward}
{leftArm_rotX} += 21'{data_0} - {x} + 0.15{forward}
{rightArm_rotZ} += 15'{data_0} - 0.1{x} +0.1{adz}
{leftArm_rotZ} -= 16'{data_0} + 0.1{x} +0.1{adz}

{rightLeg_rotX} += 40'{data_0} + 0.3{x} + 0.1{forward}
{rightLeg_rotY} += 7'{data_0}
{rightLeg_rotZ} += 3'{data_0}
{leftLeg_rotX} += 30'{data_0} - 0.3{x} + 0.1{forward}
{leftLeg_rotY} -= 8'{data_0}
{leftLeg_rotZ} -= 3'{data_0}

{leftLeg_posX} += 0.25{data_0}
{rightLeg_posX} -= 1.0{data_0}
{rightLeg_posZ} -= 5.5{data_0}
{rightLeg_posY} -= 4{data_0}

{d} *= {data_0} / 1'
{x} = min({vel} / 2, 1) / 2
out "rotate" (-{data_0}({pitch} + 70), 1, 0, 0)
out "translate" (0, -0.8{data_0}, 0)
