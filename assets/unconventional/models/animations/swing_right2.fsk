{m} = clamp(-{motY}, -110', 110')
{vel} = min(sqrt({motX}^2 + {motY}^2 + {motZ}^2), 1)
{data} = curve {data}
{x} = 0.5{data}curve clamp(-{motY}, 0, 1)
{rightArm_rotX} @ {data} -> -3 + {m}

{data} *= {vel}
{rightArm_rotZ} @ {data} -> -0.2
{leftArm_rotX} @ {data} -> {m}
{leftArm_rotZ} @ {data} -> -30' + 0.5{m}



{rightLeg_rotX} @ {data} -> 1.2{m}
{rightLeg_rotY} @ {data} -> 16'
{rightLeg_rotZ} @ {data} -> 13'
{leftLeg_rotX} @ {data} -> 30' - 0.4{m}
{leftLeg_rotY} @ {data} -> -18'
{leftLeg_rotZ} @ {data} -> -8'


{leftLeg_posX} @ {x} -> 3
{leftLeg_posY} @ {x} -> 8
{leftLeg_posZ} @ {x} -> -4.2
