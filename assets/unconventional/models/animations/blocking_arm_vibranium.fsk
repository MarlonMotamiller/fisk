{data_0} = curve {data_0}
{leftArm_rotX} @ {data_0} -> 0.3{leftArm_rotX} - 1.3
{leftArm_rotY} += 1.1{data_0}
{leftArm_rotZ} -= 0.2{data_0}

{leftArm_posZ} -= {data_0}

out "firstPerson" (true)
out "translate" (0, -{data_0}, 0)

{data_1} = curve {data_1}{data_0}
;{leftArm_rotX} @ {data_1} -> 0.2{leftArm_rotX} - 1.5
{leftArm_rotY} += 0.3{data_1}
{leftArm_rotZ} += 0.6{data_1}
{leftArm_posY} += 0.5{data_1}{data_5}
{leftArm_posZ} -= 2{data_1}{data_5}
{leftArm_posX} -= 2{data_1}{data_5}
{rightArm_posX} += 0.75{data_1}
{rightArm_posZ} += 1.25{data_1}

{body_rotY} += 25'{data_1}




{data_2} = curve {data_2}{data_0}
;{leftArm_rotX} @ {data_2} -> 0.2{leftArm_rotX} - 1.5
{leftArm_rotY} += 0.1{data_2}
{leftArm_rotZ} += 1.4{data_2}
{leftArm_posY} += 2{data_2}{data_5}
{leftArm_posZ} -= 2{data_2}
{leftArm_posX} -= 1{data_2}{data_5}
{rightArm_posX} += 0.75{data_2}
{rightArm_posZ} += 1.25{data_2}

{body_rotY} += 25'{data_2}





{data_3} = curve {data_3}{data_0}
;{leftArm_rotX} @ {data_3} -> 0.2{leftArm_rotX} - 1.5
{leftArm_rotY} += 0.0{data_3}
{leftArm_rotZ} += 0.3{data_3}
{leftArm_posZ} -= 2{data_3}{data_5}
{leftArm_posX} -= 1.5{data_3}{data_5}
{rightArm_posX} += 0.5{data_3}
{rightArm_posZ} += 1{data_3}

{body_rotY} += 15'{data_3}

{data_4} = curve {data_4}{data_0}
;{leftArm_rotX} @ {data_4} -> 0.2{leftArm_rotX} - 1.5
{leftArm_rotY} += 0.3{data_4}
{leftArm_rotZ} -= 0.3{data_4}
{leftArm_posZ} -= 2{data_4}
{leftArm_posX} -= {data_4}{data_5}
{rightArm_posX} += 0.5{data_4}
{rightArm_posZ} += 1{data_4}

{body_rotY} += 15'{data_4}