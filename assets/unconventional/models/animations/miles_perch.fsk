{data} = curve {data}

{head_rotX} += 0'{data}
{head_rotY} += 0'{data}
{head_rotZ} += 0'{data}
{head_posX} @ {data} -> 0
{head_posY} @ {data} -> 4
{head_posZ} @ {data} -> -4


{body_rotX} @ {data} -> 30'
{body_rotY} @ {data} -> 5'
{body_rotZ} @ {data} -> 0
{body_posX} @ {data} -> 0
{body_posY} @ {data} -> 4
{body_posZ} @ {data} -> -4


{rightArm_rotX} @ {data} -> -20'
{rightArm_rotY} -= 10'{data}
{rightArm_rotZ} += 40'{data}

{rightArm_posX} @ {data} -> -5
{rightArm_posY} @ {data} -> 6
{rightArm_posZ} @ {data} -> -3


{leftArm_rotX} @ {data} -> -40'
{leftArm_rotY} += 40'{data}
{leftArm_rotZ} -= 50'{data}

{leftArm_posX} @ {data} -> 5
{leftArm_posY} @ {data} -> 5
{leftArm_posZ} @ {data} -> -3

{d} = sin(pi{data})
{rightLeg_rotX} @ {data} -> 60'
{rightLeg_rotY} @ {data} -> 50'
{rightLeg_rotZ} @ {data} -> 0'

{rightLeg_posX} @ {data} -> -9
{rightLeg_posY} @ {data} -> 12
{rightLeg_posZ} @ {data} -> -5

{rightLeg_rotX} += 0'{d}
{rightLeg_posY} -= 0{d}
{rightLeg_posZ} -= 0{d}


{leftLeg_rotX} @ {data} -> 60'
{leftLeg_rotY} @ {data} -> -50'
{leftLeg_rotZ} @ {data} -> 0'

{leftLeg_posX} @ {data} -> 9
{leftLeg_posY} @ {data} -> 12
{leftLeg_posZ} @ {data} -> -5

{leftLeg_rotX} += 0'{d}
{leftLeg_posZ} -= 0{d}

out "pivot" (0, 0.56, 0)
out "translate" (0, -0.2{data}, 0.0{data})
out "rotate" (0{data}, 0, 0, 1)
out "rotate" (-0{data}, 0, 1, 0)
out "rotate" (-0{data}, 1, 0, 0)
