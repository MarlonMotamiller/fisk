{x} = curve {data}
{data} = sin(pi(1 - {data}))^2

{head_posX} @ {data} -> -1
{head_posY} @ {data} -> -0.2
{head_posZ} @ {data} -> -0.6

{head_rotX} @ {data} -> 0.32
{head_rotY} @ {data} -'> -0.5
{head_rotZ} @ {data} -> 0.1


{body_rotX} @ {data} -> 0.225
{body_rotY} @ {data} -> -0.275
{body_rotZ} @ {data} -> -0.425


{rightArm_posX} @ {data} -> -3.0
{rightArm_posY} @ {data} -> 3
{rightArm_posZ} @ {data} -> -2

{rightArm_rotX} @ {data} -> -1.15
{rightArm_rotY} @ {data} -'> -0.45
{rightArm_rotZ} @ {data} -> 0.1


{leftArm_posX} @ {data} -> 6.5
{leftArm_posY} @ {data} -> 0.0
{leftArm_posZ} @ {data} -> 2.0

{leftArm_rotX} @ {data} -> -0.4
{leftArm_rotY} @ {data} -'> -0.025
{leftArm_rotZ} @ {data} -> -1.75


{rightLeg_posX} @ {data} -> -3
{rightLeg_posY} @ {data} -> 10
{rightLeg_posZ} @ {data} -> -4.25

{rightLeg_rotX} @ {data} -> 1.1
{rightLeg_rotY} @ {data} -'> 0.8
{rightLeg_rotZ} @ {data} -> 0


{leftLeg_posX} @ {data} -> 7
{leftLeg_posY} @ {data} -> 9
{leftLeg_posZ} @ {data} -> 0

{leftLeg_rotX} @ {data} -> -1.85
{leftLeg_rotY} @ {data} -'> 0.4
{leftLeg_rotZ} @ {data} -> -0.35

out "pivot" (0, 0.56, 0)
out "rotate" (-360{x}, 0, 1, 0)
