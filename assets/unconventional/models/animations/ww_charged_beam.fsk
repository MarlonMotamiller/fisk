{data_0} = curve {data_0}*(1-{data_1})
{data_1} = curve {data_1}
{body_rotY} -= 60'sin(pi{data_1}){data_0}
{leftArm_posZ} += 2sin(pi{data_1}){data_0}
{rightArm_posZ} -= 2sin(pi{data_1}){data_0}
{data_1} = min({data_1}*1.3, 1)
{leftArm_rotX} @ {data_0} -> - 1.3
{leftArm_rotY} -= 0.2{data_0}
{leftArm_rotZ} -= 0.5{data_0}
{leftArm_posZ} -= 1.5{data_0}

{body_rotY} += 20'{data_0}

{rightArm_rotX} @ {data_0} -> - 1.6
{rightArm_rotY} += 0.4{data_0}
{rightArm_rotZ} += 0.3{data_0}
{rightArm_posZ} += 1.5{data_0}


{leftArm_rotX} @ {data_1} -> - 2.5
;{leftArm_rotX} -= 0.3sin(pi{data_1})
{leftArm_rotY} @ {data_1} -> 1.3
{leftArm_rotY} -= 0.7sin(pi{data_1})
{leftArm_rotZ} @ {data_1} -> - 0.5
{leftArm_posZ} -= 1.5{data_1}
{leftArm_posX} -= {data_1}


{rightArm_rotX} @ {data_1} -> - 2.3 
;{rightArm_rotX} -= 0.5sin(pi{data_1})
{rightArm_rotY} @ {data_1} -> - 0.9
{rightArm_rotY} += 0.7sin(pi{data_1})
{rightArm_rotZ} @ {data_1} -> 0.3
{rightArm_posZ} -= 2.5{data_1}
{rightArm_posX} += {data_1}

