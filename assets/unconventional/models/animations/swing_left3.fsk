{m} = clamp(-{motY}, -110', 70')
{m1} = clamp(-{motY}, 0, 70')
{m2} = clamp(-{motY}, -110, 0)
{vel} = min(sqrt({motX}^2 + {motY}^2 + {motZ}^2), 1)
{data} = curve {data}
{x} = {data}curve clamp(-{motY}, 0, 1)
{leftArm_rotX} @ {data} -> -3 + 1.5{m}
{leftArm_rotY} @ {data} -> 0.3{m}

{data} *= {vel}
{leftArm_rotZ} @ {data} -> 0.2
{rightArm_rotX} @ {data} -> 0.9{m}
{rightArm_rotZ} @ {data} -> 90' + 0.5{m}

{body_rotZ} @ {data} -> -0.1



{rightLeg_rotX} @ {data} -> -40' - 1.6{m2}
{rightLeg_rotY} @ {data} -> 28'
{rightLeg_rotZ} @ {data} -> 0'
{leftLeg_rotX} @ {data} -> 40' + 1.4{m2}
{leftLeg_rotY} @ {data} -> -25'
{leftLeg_rotZ} @ {data} -> -3'


{rightLeg_posX} @ {x} -> -2.7 + 1{m1}
{rightLeg_posY} @ {x} -> 11.5
{rightLeg_posZ} @ {x} -> -1 + 0.5{m1}

{leftLeg_posX} @ {data} -> 3.5 + 0.5{m2} + 1{m1}
{leftLeg_posY} @ {data} -> 9 + 0.5{m2}
{leftLeg_posZ} @ {data} -> -3.2 - 1.5{m2} - 0.6{m1}