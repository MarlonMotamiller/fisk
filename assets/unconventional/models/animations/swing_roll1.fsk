{x} = curve {data}
{data} = sin(pi(1 - {data}))^2

{head_rotX} @ {data} -> -0.8
{head_rotY} @ {data} -> -0.4
{rightArm_rotX} @ {data} -> 1.1
{rightArm_rotY} @ {data} -> 0.5
{rightArm_rotZ} @ {data} -> 0.4
{leftArm_rotX} @ {data} -> -1.0
{leftArm_rotY} @ {data} -> 0.5
{leftArm_rotZ} @ {data} -> -0.4

{rightLeg_rotX} @ {data} -> -0.4
{leftLeg_rotX} @ {data} -> 0.2

{rightLeg_rotY} @ {data} -> -0.3
{leftLeg_rotY} @ {data} -> -0.3

out "pivot" (0, 0.5, 0)
out "rotate" (360{x}, 0.0, 1, 0.0)
